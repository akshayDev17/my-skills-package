{
  "name": "portfolio-app",
  "version": "0.1.0",
  "description": "Bootstrap a new sub-app of a personal site on Cloudflare: its Access app for the path, its D1 database id, and its GitHub production secrets — plan by default, apply on request — plus a token-free login check every deploy job can run first.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "bin": { "portfolio-app": "skills/portfolio-app/scripts/portfolio-app.mjs" },
  "exports": { ".": "./lib/index.js", "./package.json": "./package.json" },
  "files": ["lib", "skills", "plugin.json", ".claude-plugin/plugin.json", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "engines": { "node": ">=20", "dsh": ">=0.1.0-rc.6" },
  "repository": { "type": "git", "url": "git+https://github.com/akshayDev17/my-skills-package.git",
                  "directory": "packages/portfolio-app" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "keywords": ["cloudflare", "cloudflare-access", "d1", "github-actions", "bootstrap"]
}
